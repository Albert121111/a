generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  MEMBER
  TRAINER
  ADMIN
}

enum BookingStatus {
  CONFIRMED
  WAITLIST
  CANCELLED
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  passwordHash  String?
  role          Role     @default(MEMBER)
  locale        String   @default("ru")
  createdAt     DateTime @default(now())
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  memberships   UserMembership[]
  payments      Payment[]
}

model Trainer {
  id              String   @id @default(cuid())
  slug            String   @unique
  nameRu          String
  nameEn          String
  bioRu           String
  bioEn           String
  specializations String[]
  certifications  String[]
  socialLinks     Json?
  image           String
  classes         ClassSession[]
}

model ClassType {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameRu    String
  nameEn    String
  level     String
  sessions  ClassSession[]
}

model Location {
  id        String   @id @default(cuid())
  nameRu    String
  nameEn    String
  capacity  Int
  sessions  ClassSession[]
}

model ClassSession {
  id            String      @id @default(cuid())
  startsAt      DateTime
  endsAt        DateTime
  seatsLimit    Int
  titleRu       String
  titleEn       String
  classTypeId   String
  trainerId     String
  locationId    String
  classType     ClassType   @relation(fields: [classTypeId], references: [id])
  trainer       Trainer     @relation(fields: [trainerId], references: [id])
  location      Location    @relation(fields: [locationId], references: [id])
  bookings      Booking[]
}

model Booking {
  id             String        @id @default(cuid())
  status         BookingStatus
  userId         String
  classSessionId String
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id])
  classSession   ClassSession  @relation(fields: [classSessionId], references: [id])

  @@unique([userId, classSessionId])
}

model MembershipPlan {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleRu     String
  titleEn     String
  descriptionRu String
  descriptionEn String
  price       Int
  visits      Int?
  durationDays Int
  stripePriceId String?
  memberships UserMembership[]
}

model UserMembership {
  id          String   @id @default(cuid())
  userId      String
  planId      String
  active      Boolean  @default(true)
  startsAt    DateTime @default(now())
  endsAt      DateTime
  remainingVisits Int?
  user        User     @relation(fields: [userId], references: [id])
  plan        MembershipPlan @relation(fields: [planId], references: [id])
}

model Payment {
  id             String   @id @default(cuid())
  userId         String
  amount         Int
  status         String
  provider       String
  providerRef    String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}

model HeroSlide {
  id        String @id @default(cuid())
  titleRu   String
  titleEn   String
  subtitleRu String
  subtitleEn String
  image     String
  ctaLink   String
  active    Boolean @default(true)
}

model BlogPost {
  id        String @id @default(cuid())
  slug      String @unique
  titleRu   String
  titleEn   String
  excerptRu String
  excerptEn String
  contentRu String
  contentEn String
  image     String
  publishedAt DateTime @default(now())
}

model Review {
  id        String @id @default(cuid())
  author    String
  textRu    String
  textEn    String
  rating    Int
}

model Lead {
  id        String @id @default(cuid())
  name      String
  email     String
  message   String
  type      String
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}
